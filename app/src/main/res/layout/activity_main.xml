<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    android:padding="@dimen/screen_padding"
    tools:context=".MainActivity">

    <!-- Chain vertical "packed" com bias: o bloco fica um pouco acima do centro -->
    <ImageView
        android:id="@+id/imageCase"
        android:layout_width="@dimen/hero_image_size"
        android:layout_height="@dimen/hero_image_size"
        android:contentDescription="@string/cd_radio_tower"
        android:src="@drawable/ic_radio_tower"
        app:layout_constraintBottom_toTopOf="@id/textFileNumber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/textFileNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_stamp"
        android:fontFamily="monospace"
        android:letterSpacing="0.15"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:text="@string/central_file_number"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="@color/stamp_red"
        app:layout_constraintBottom_toTopOf="@id/textCaseTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageCase" />

    <TextView
        android:id="@+id/textCaseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:fontFamily="monospace"
        android:text="@string/central_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textColor="@color/phosphor"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/textCaseSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textFileNumber" />

    <TextView
        android:id="@+id/textCaseSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:gravity="center"
        android:text="@string/central_subtitle"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/text_secondary"
        app:layout_constraintBottom_toTopOf="@id/inputLayoutCodename"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCaseTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutCodename"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_codename"
        app:layout_constraintBottom_toTopOf="@id/inputLayoutAccessCode"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textCaseSubtitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCodename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="30"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutAccessCode"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:hint="@string/hint_access_code"
        app:endIconMode="password_toggle"
        app:helperText="@string/helper_access_code"
        app:layout_constraintBottom_toTopOf="@id/textReadinessLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/inputLayoutCodename"
        app:layout_constraintTop_toBottomOf="@id/inputLayoutCodename">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editAccessCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="numberPassword"
            android:maxLength="3"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/textReadinessLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_small"
        android:text="@string/readiness_label"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/text_primary"
        app:layout_constraintBottom_toTopOf="@id/seekReadiness"
        app:layout_constraintEnd_toStartOf="@id/textReadinessValue"
        app:layout_constraintStart_toStartOf="@id/inputLayoutCodename"
        app:layout_constraintTop_toBottomOf="@id/inputLayoutAccessCode" />

    <TextView
        android:id="@+id/textReadinessValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/phosphor"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/textReadinessLabel"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="0%" />

    <SeekBar
        android:id="@+id/seekReadiness"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/phosphor"
        android:thumbTint="@color/phosphor"
        app:layout_constraintBottom_toTopOf="@id/textReadinessError"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/inputLayoutCodename"
        app:layout_constraintTop_toBottomOf="@id/textReadinessLabel" />

    <TextView
        android:id="@+id/textReadinessError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/error_coral"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/buttonClear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/inputLayoutCodename"
        app:layout_constraintTop_toBottomOf="@id/seekReadiness"
        tools:text="@string/error_readiness"
        tools:visibility="visible" />

    <!-- Chain horizontal: Limpar | Acessar dossiê -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonClear"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_large"
        android:layout_marginEnd="@dimen/spacing_small"
        android:text="@string/button_clear"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/buttonAccess"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@id/inputLayoutCodename"
        app:layout_constraintTop_toBottomOf="@id/textReadinessError" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAccess"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginStart="@dimen/spacing_small"
        android:text="@string/button_access"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1.4"
        app:layout_constraintStart_toEndOf="@id/buttonClear"
        app:layout_constraintTop_toTopOf="@id/buttonClear" />

</androidx.constraintlayout.widget.ConstraintLayout>
